# Payee wallet — Alex's Solana payout wallet (receive-only).
# Public receiving address only. NEVER put a private key or seed phrase here.
SOLANA_WALLET_ADDRESS=Bkd6W9THp8qKgCYcamEkYx4Rk6TTHkUnRsegMaDZXwz2
# Facilitator for Solana settlement. Optional: defaults to PayAI
# (https://facilitator.payai.network), verified to support x402 v2
# "exact" on Solana mainnet.
# FACILITATOR_URL=
# Base RPC endpoint (the endpoints serve Base data). Optional: when
# unset, the service uses the public Base endpoint
# (https://mainnet.base.org). Never commit a URL containing an API key.
# ALCHEMY_BASE_RPC=
# Port the service listens on. Default: 4020.
PORT=4020
